# Neon PostgreSQL connection string
DATABASE_URL=postgresql://<username>:<password>@<neon-host>/<database>?sslmode=require

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the real value. Keep this in backend/.env only.
JWT_SECRET_KEY=<generate-a-strong-random-secret>

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000