# SAKSHAM Frontend Environment Configuration
# Main Backend API Gateway (FastAPI on port 8000)
# Note: Frontend communicates with port 8000 only. Never connect directly to AI microservice on 8001.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Dedicated News API for Discover section (Approach 3: Authentic publisher images)
# Free tier: 100 requests/day at https://gnews.io
GNEWS_API_KEY=
# Alternative: https://newsapi.org
NEWS_API_KEY=
